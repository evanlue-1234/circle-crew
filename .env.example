# Supabase project URL (Project Settings → API Keys → Project URL)
VITE_SUPABASE_URL=

# Supabase publishable key, starts with sb_publishable_... (safe for the browser; protect with RLS)
# NEVER put the secret key here — it bypasses all security and must stay server-side only.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set to "true" once Google OAuth is actually configured in Supabase (Authentication ->
# Providers -> Google) to show the "Continue with Google" button on the account step of
# onboarding. Left unset, that button doesn't render at all.
VITE_GOOGLE_OAUTH_ENABLED=
